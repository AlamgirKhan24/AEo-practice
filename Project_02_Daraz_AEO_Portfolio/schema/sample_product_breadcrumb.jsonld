{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Product",
      "@id": "https://example.com/products/verified-model#product",
      "name": "[Brand] [Exact verified model] [capacity] Power Bank",
      "description": "[Concise description matching visible page content; only verified features.]",
      "image": ["https://example.com/images/verified-model-main.jpg"],
      "sku": "[seller SKU for exact variant]",
      "brand": { "@type": "Brand", "name": "[verified brand]" },
      "offers": {
        "@type": "Offer",
        "url": "https://example.com/products/verified-model",
        "priceCurrency": "PKR",
        "price": "[current numeric price from visible offer]",
        "availability": "https://schema.org/InStock",
        "itemCondition": "https://schema.org/NewCondition",
        "seller": { "@type": "Organization", "name": "[actual seller shown to shoppers]" }
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://example.com/" },
        { "@type": "ListItem", "position": 2, "name": "Electronics", "item": "https://example.com/electronics" },
        { "@type": "ListItem", "position": 3, "name": "Power Banks", "item": "https://example.com/electronics/power-banks" },
        { "@type": "ListItem", "position": 4, "name": "[Exact verified model]", "item": "https://example.com/products/verified-model" }
      ]
    }
  ]
}
